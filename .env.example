# ==============================================================================
# BuildIntel - Comprehensive Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' in the project root:
#      cp .env.example .env      (Linux/macOS)
#      copy .env.example .env    (Windows PowerShell / CMD)
# 2. Update the values below to match your local or Docker environment.
# 3. NEVER commit your actual '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# DB_HOST: Hostname or IP of the PostgreSQL instance.
#   - For Docker Compose: defaults to 'postgres' (the Compose service name)
#   - For Manual Local Run: set to 'localhost' or '127.0.0.1'
# Required: YES
DB_HOST=localhost

# DB_PORT: Listening port of PostgreSQL.
# Default: 5432
# Required: YES
DB_PORT=5432

# DB_NAME: Database name for BuildIntel tables.
# Default: buildintel_db
# Required: YES
DB_NAME=buildintel_db

# DB_USER: PostgreSQL username.
# Default: postgres
# Required: YES
DB_USER=postgres

# DB_PASSWORD: Password for the PostgreSQL user.
# For security, choose a strong, unique password.
# Required: YES
DB_PASSWORD=your_secure_password_here

# ------------------------------------------------------------------------------
# 2. Spring Boot Backend Configuration
# ------------------------------------------------------------------------------
# SERVER_PORT: Internal HTTP port for the Spring Boot application.
# Default: 8080
# Required: NO (defaults to 8080)
SERVER_PORT=8080

# BACKEND_PORT: Host port mapping for Spring Boot when using Docker Compose.
# Default: 8080
# Required: NO (defaults to 8080)
BACKEND_PORT=8080

# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed browser origins.
# Required: NO (defaults to Angular dev server and standard localhost ports)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:4200,http://127.0.0.1:4200

# ------------------------------------------------------------------------------
# 3. Angular Frontend Configuration
# ------------------------------------------------------------------------------
# FRONTEND_PORT: Host port mapping for Angular SPA / Nginx when using Docker Compose.
# Default: 80 (change to 4200 or 8081 if port 80 is occupied on your host)
# Required: NO (defaults to 80)
FRONTEND_PORT=80

# ------------------------------------------------------------------------------
# 4. Python Scraper & Subprocess Execution (Optional Overrides)
# ------------------------------------------------------------------------------
# PYTHON_EXECUTABLE: Absolute or relative path to the Python binary.
#   - Leave blank for auto-detection (detects virtual environments or system PATH)
#   - In Docker: preconfigured to /app/venv/bin/python
#   - In Windows manual: e.g. venv/Scripts/python.exe
# Required: NO
PYTHON_EXECUTABLE=

# SCRAPER_SCRIPT_PATH: Path to the MahaRERA scraper entrypoint (scraper.py).
#   - Leave blank for auto-detection (checks ./Scrapper/scraper.py)
# Required: NO
SCRAPER_SCRIPT_PATH=

# EXPORT_SCRIPT_PATH: Path to the Excel export utility (export_excel.py).
#   - Leave blank for auto-detection (checks ./Scrapper/export_excel.py)
# Required: NO
EXPORT_SCRIPT_PATH=

# EXPORTS_DIR: Destination directory where generated Excel files will be saved.
#   - Leave blank for auto-detection (defaults to project exports/ directory)
# Required: NO
EXPORTS_DIR=
