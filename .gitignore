# ==============================================================================
# BuildIntel - Production-Grade Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Secrets & Environment Configurations (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Private keys, certificates, keystores
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore

# ------------------------------------------------------------------------------
# 2. Python & Virtual Environments
# ------------------------------------------------------------------------------
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized files
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.zip
*.tar.gz
*.tgz
*.7z

# Unit test / coverage
.pytest_cache/
**/ .pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.mypy_cache/
.pyre/
.pytype/

# ------------------------------------------------------------------------------
# 3. Java & Maven (Spring Boot Backend)
# ------------------------------------------------------------------------------
target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar
*.rar

# Maven wrapper executable binaries
.mvn/wrapper/maven-wrapper.jar
Backend/.mvn/wrapper/maven-wrapper.jar

# Spring Boot devtools restart marker
.reloadmarker
.spring-boot-devtools.properties

# ------------------------------------------------------------------------------
# 4. Node.js & Angular Frontend
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
Frontend/node_modules/

# Angular build outputs & caches
dist/
**/dist/
Frontend/dist/
.angular/
**/.angular/
Frontend/.angular/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 5. IDEs, Editors & Metadata
# ------------------------------------------------------------------------------
# Eclipse IDE
.metadata/
**/.metadata/
.classpath
.project
.settings/
**/.classpath
**/.project
**/.settings/
*.launch
*.psfs

# Visual Studio Code
.vscode/
**/.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# IntelliJ IDEA
.idea/
**/.idea/
*.iws
*.iml
*.ipr
out/

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/
nbactions.xml
nb-configuration.xml

# Visual Studio / Windows
*.suo
*.user
*.userosscache
*.sln.docstates

# ------------------------------------------------------------------------------
# 6. Database Dumps, Temporary & Export Files
# ------------------------------------------------------------------------------
*.dump
*.dump.*
*.sqlite3
*.db
*.backup

# Ignore ad-hoc SQL dumps, but preserve official schema and migration scripts
*.sql
!database/*.sql
!docker/**/*.sql
!init.sql

# Generated export spreadsheets (preserve directory structure via .gitkeep)
exports/*.xlsx
exports/*.xls
exports/*.csv
!exports/.gitkeep

# Temporary / scratch files
*.tmp
*.temp
*.bak
*.swp
*~
scratch/
brain/

# Application logs
*.log
**/*.log
logs/
**/logs/

# ------------------------------------------------------------------------------
# 7. Operating System Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
